[
  {
    "file": "wemo_gpl_snsv2_package-11420/package/belkin/WeMo_SNSV2/files/etc/init.d/waspd",
    "bytes": 6150,
    "strings": [
      "WASPDEBUG=1",
      "API_DEBUG_FILE=/tmp/Belkin_settings/wasp_debug_level",
      "if [ $WASPDEBUG -eq 0 ]; then",
      "    WASPD=\"/sbin/waspd\"",
      "    if [ -e $API_DEBUG_FILE ]; then",
      "        rm $API_DEBUG_FILE",
      "    WASPD=\"/sbin/waspd -L1 -v489\"",
      "    if [ ! -e $API_DEBUG_FILE ]; then",
      "        echo 21 > $API_DEBUG_FILE",
      "TEMP_DIR=/tmp/wasp.tmp",
      "    logger \"waspd: $1\"",
      "    $WASPD -c1 -u /wasp_firmware/00020004_0_3.bootldr",
      "      $WASPD -c1 -u /wasp_firmware/00020004_0_3.bootldr",
      "    $WASPD $HwRev -c1",
      "    $WASPD -V -v400 > $TEMP_DIR/e",
      "    grep WASP_ERR_NOT_READY $TEMP_DIR/e > $TEMP_DIR/ee",
      "    # WASP is not ready, assume we have old LPR FW and restart with",
      "       logit \"Internal error: wasp is not ready in mcu_fw_update\"",
      "        $WASPD -C0",
      "      $WASPD -C1",
      "      $WASPD -C2",
      "        $WASPD -s128:12:0",
      "        $WASPD -e",
      "          $WASPD $HwRev -c0",
      "            $WASPD $HwRev -c1",
      "          $WASPD -Da -F2 -boot",
      "          $WASPD $HwRev -c2",
      "        # restart waspd",
      "        $WASPD $HwRev -Daemon",
      "        $WASPD -s128:12:1",
      "        $WASPD -V -v400 > $TEMP_DIR/e",
      "        grep WASP_ERR_NOT_READY $TEMP_DIR/e > $TEMP_DIR/ee",
      "           logit \"Internal error: wasp is not ready in mcu_fw_update after update\"",
      "   $WASPD -Daemon $HwRev",
      "   # $WASPD -Daemon -bus:1",
      "   # wait for wasp ready",
      "        waspd -V",
      "       logit \"Error: timeout waiting for WASP to become ready\"",
      "   $WASPD -e"
    ]
  },
