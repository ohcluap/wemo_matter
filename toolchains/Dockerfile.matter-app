FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends build-essential clang gn ninja-build pkg-config python3 python3-pip python3-venv python3-dev git libssl-dev libglib2.0-dev libdbus-1-dev libreadline-dev libavahi-client-dev ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*
COPY toolchains/requirements-matter.txt /tmp/requirements-matter.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -r /tmp/requirements-matter.txt
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /sdk
